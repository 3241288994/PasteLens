{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities required by the PasteLens floating window and local clipboard renderer",
  "windows": ["ball", "viewer"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "dialog:default",
    "fs:allow-write-file",
    "opener:default"
  ]
}
